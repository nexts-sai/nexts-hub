{
  "id": "boss-zhipin",
  "display_name": "BOSS Zhipin",
  "description": "Access the user's signed-in BOSS Zhipin recruiter dashboard through the Nexts Chrome extension. Provides candidate search, batch deduplication, resume viewing, a local candidate database, filtering and scoring, reports, and candidate messaging tools. Data is processed only on the user's device. Login and security checks are respected, and messaging requires explicit confirmation.",
  "summary": "MCP tools for candidate search and management on BOSS Zhipin.",
  "homepage_url": "https://www.zhipin.com",
  "repository_url": "https://github.com/Snseam/boss-zhipin-mcp",
  "icon_url": null,
  "category": "Productivity",
  "tags": [
    "recruiting",
    "workflow",
    "chrome",
    "boss-zhipin"
  ],
  "publisher": "Nexts AI",
  "verified": true,
  "distribution_type": "nexts_hub",
  "auth_types": [
    "no_auth"
  ],
  "version": "0.2.1",
  "package_url": "https://s.nexts.cc/extend/mcp/boss-zhipin/0.2.1/boss-zhipin-0.2.1.zip",
  "package_sha256": "e88f9b888f4af521009ca1f0a3f008c2451697c9d749ed22ac3f0e389bb2890f",
  "package_size_bytes": 18922,
  "min_nexts_version": "0.1.21",
  "kernel_api": "mcp-2025-03-26",
  "transport": "stdio",
  "command": null,
  "args": [],
  "env": {},
  "url": null,
  "headers": {},
  "configuration_fields": [],
  "operations": [
    {
      "name": "boss_login",
      "description": "Open the recruiter page and check login or verification status.",
      "access": "write",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "boss_search_candidates",
      "description": "Search, scroll, deduplicate, and persist candidates locally.",
      "access": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "experience": {
            "type": "string"
          },
          "salary": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          },
          "tabId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "keyword"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "boss_multi_search",
      "description": "Run a deduplicated multi-keyword search pipeline with optional automatic viewing.",
      "access": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "city": {
            "type": "string"
          },
          "experience": {
            "type": "string"
          },
          "count_per_keyword": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          },
          "auto_view": {
            "type": "boolean"
          },
          "tabId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "boss_clear_dedup",
      "description": "Clear local candidate records by ID, status, date, or all records.",
      "access": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "expect_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "before_date": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "boss_view_candidate",
      "description": "View a candidate profile URL and save a local screenshot.",
      "access": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "profile_url": {
            "type": "string"
          },
          "tabId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "profile_url"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "boss_view_by_index",
      "description": "Open a candidate by index, save resume screenshots, and extract a share link when available.",
      "access": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "tabId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "index"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "boss_view_by_expect_id",
      "description": "Find and view a visible candidate by expectId.",
      "access": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "expect_id": {
            "type": "string"
          },
          "tabId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "expect_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "boss_greet_by_index",
      "description": "Contact a candidate by result index after explicit confirmation.",
      "access": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string"
          },
          "confirm": {
            "type": "boolean",
            "const": true
          },
          "tabId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "index",
          "confirm"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "boss_evaluate_candidate",
      "description": "Evaluate a resume using local job-profile keyword rules.",
      "access": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "resume": {
            "type": "object"
          },
          "job_requirements": {
            "type": "string"
          }
        },
        "required": [
          "resume"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "boss_send_greeting",
      "description": "Contact a candidate by profile URL after explicit confirmation.",
      "access": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "profile_url": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "confirm": {
            "type": "boolean",
            "const": true
          },
          "tabId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "profile_url",
          "confirm"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "boss_query_db",
      "description": "Query the local candidate database.",
      "access": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "has_share_url": {
            "type": "boolean"
          },
          "keyword": {
            "type": "string"
          },
          "date_from": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "boss_update_candidate",
      "description": "Update local candidate status, score, notes, or share URL.",
      "access": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "expect_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "notes": {
            "type": "string"
          },
          "share_url": {
            "type": "string"
          }
        },
        "required": [
          "expect_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "boss_pipeline_status",
      "description": "Return local recruitment-pipeline statistics and recovery suggestions.",
      "access": "read",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "boss_filter_and_score",
      "description": "Filter and score candidates using the local search profile.",
      "access": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "top_n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "boss_export_report",
      "description": "Export shortlisted candidates as a Markdown report.",
      "access": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "top_n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "include_detail": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "boss_debug_page",
      "description": "Inspect the current BOSS page DOM structure.",
      "access": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "tabId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "boss_reload",
      "description": "Reload the local candidate database and search profile.",
      "access": "write",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    }
  ],
  "enabled_by_default": false,
  "platforms": [
    "windows"
  ]
}
