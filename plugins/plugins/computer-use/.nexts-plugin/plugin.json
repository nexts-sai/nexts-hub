    {
      "name": "perform_secondary_action",
      "description": "nexts-window2: perform an action label shown in the latest accessibility state, such as Expand, Collapse or Scroll Down.",
      "parameters": {
        "type": "object",
        "properties": {
          "window": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0
