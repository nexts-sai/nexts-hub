    {
      "name": "focus_window",
      "description": "Restore and activate an observed desktop window before physical keyboard input. Returns the focused window; fails if the target is stale or Windows refuses focus. Do not type after failure.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "requires_confirmation": true
    },
    {
      "name": "request_app_access",
      "description": "Approve the exact app requested by the nexts-window2 driver for this session. This does not execute the blocked action. Re-observe the window afterward.",
      "parameters": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string"
          }
        },
        "required": [
