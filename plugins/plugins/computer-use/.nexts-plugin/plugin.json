{
  "name": "computer-use",
  "version": "1.5.0",
  "description": "Control desktop apps on Windows from Nexts through Computer Use.",
  "author": {
    "name": "Nexts AI",
    "email": "support@nexts.ai",
    "url": "https://nexts.ai/"
  },
  "homepage": "https://nexts.ai/",
  "repository": "https://nexts.ai/",
  "license": "Nexts Proprietary",
  "keywords": [
    "computer-use",
    "desktop-control",
    "windows",
    "automation",
    "accessibility"
  ],
  "skills": "./skills/",
  "interface": {
    "displayName": "Computer Use",
    "shortDescription": "Control Windows apps from Nexts",
    "longDescription": "Control Windows apps through the Nexts Computer Use plugin. The desktop client reuses Nexts Primary Runtime Node and its built-in native driver. No Codex, external Node, npm installation or separate Computer Use download is required. Nexts prepares the shared runtime automatically when necessary. Screenshots may be sent to the selected vision model for the current task; they are never sent to the account service. App access is session-scoped and can be stopped at any time.",
    "developerName": "Nexts AI",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Read",
      "Write"
    ],
    "websiteURL": "https://nexts.ai/",
    "privacyPolicyURL": "https://nexts.ai/policies/row-privacy-policy/",
    "termsOfServiceURL": "https://nexts.ai/policies/row-terms-of-use/",
    "logo": "./assets/app-icon.png",
    "defaultPrompt": [
      "Play a playlist to help me lock in",
      "Build and run the project I already have open in Visual Studio",
      "Open Notepad and turn these bullets into a clean draft"
    ],
    "brandColor": "#2563EB",
    "screenshots": []
  },
  "tools": [
    {
      "name": "request_access",
      "description": "Request user-approved access to inspect and control the local desktop for this agent session.",
      "parameters": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          },
          "api_version": {
            "type": "string",
            "enum": [
              "window2",
              "native"
            ],
            "description": "Use window2 for the Nexts-managed Node bridge and built-in native driver. Older callers omit this to retain legacy screen-coordinate behavior."
          }
        },
        "required": [
          "reason"
        ]
      },
      "requires_confirmation": true
    },
    {
      "name": "get_state",
      "description": "Return active driver diagnostics and discover visible target windows. Legacy mode additionally reports cursor and foreground window state. Discovery invalidates earlier observations.",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "requires_confirmation": false
    },
    {
      "name": "list_apps",
      "description": "List running applications and returned window objects. Listing invalidates earlier input observations. Launch an explicit app identifier/path if it is not running.",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "requires_confirmation": false
    },
    {
      "name": "get_window",
      "description": "Return a currently visible window by id after access is granted.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "app": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "requires_confirmation": false
    },
    {
      "name": "launch_app",
      "description": "Launch a Windows app by app id, executable name, URI, or executable path after Computer Use access is granted. Shell, terminal, and script host apps require explicit risky confirmation.",
      "input_schema": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "description": "App id, executable name, URI, or executable path, for example mspaint, notepad, calc, or ms-settings:."
          },
          "allow_risky": {
            "type": "boolean",
            "description": "Set true only after the user explicitly confirms launching a shell, terminal, or script host app. Normal app launches should omit this or set false.",
            "default": false
          }
        },
        "required": [
          "app"
        ]
      },
      "requires_confirmation": true,
      "parameters": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "description": "App id, executable name, URI, or executable path, for example mspaint, notepad, calc, or ms-settings:."
          },
          "allow_risky": {
            "type": "boolean",
            "description": "Set true only after the user explicitly confirms launching a shell, terminal, or script host app. Normal app launches should omit this or set false.",
            "default": false
          }
        },
        "required": [
          "app"
        ]
      }
    },
    {
      "name": "get_window_state",
      "description": "Observe a selected window. nexts-window2: provide the returned window object; screenshot defaults true and include_text defaults false. Returns bounded screenshots with ids plus optional focused/selected/document text. nexts-native: use window_id and the legacy screen-coordinate state.",
      "parameters": {
        "type": "object",
        "properties": {
          "window_id": {
            "type": "integer"
          },
          "include_screenshot": {
            "type": "boolean"
          },
          "window": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0
              },
              "app": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "app"
            ],
            "additionalProperties": false,
            "description": "Exact window object returned by list_windows, list_apps, or get_window. Never invent one."
          },
          "include_text": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "requires_confirmation": false
    },
    {
      "name": "screenshot",
      "description": "Capture a PNG screenshot of the current desktop after access is granted.",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "requires_confirmation": false
    },
    {
      "name": "list_windows",
      "description": "List visible desktop windows after access is granted.",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "requires_confirmation": false
    },
    {
      "name": "get_foreground_window",
      "description": "Return the current foreground desktop window after access is granted.",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "requires_confirmation": false
    },
    {
      "name": "get_cursor_position",
      "description": "Return the current mouse cursor position after access is granted.",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "requires_confirmation": false
    },
    {
      "name": "get_accessibility_tree",
      "description": "Return an indexed Windows UI Automation control tree with opaque element_ref values, supported semantic patterns, and control state for a target window after access is granted. Falls back to visible-window pseudo-elements if UIA is unavailable. When no actionable UIA controls are found, also returns a screenshot and visual interaction guidance.",
      "parameters": {
        "type": "object",
        "properties": {
          "window_id": {
            "type": "integer"
          },
          "window": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0
              },
              "app": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "app"
            ],
            "additionalProperties": false,
            "description": "Exact window object returned by list_windows, list_apps, or get_window. Never invent one."
          }
        }
      },
      "requires_confirmation": false
    },
    {
      "name": "perform_semantic_action",
      "description": "Perform a Windows UI Automation pattern action on an element_ref without moving the physical pointer. Refresh the accessibility tree if the reference is stale. This tool never silently falls back to coordinate input.",
      "parameters": {
        "type": "object",
        "properties": {
          "element_ref": {
            "type": "string",
            "description": "Opaque reference returned by get_accessibility_tree."
          },
          "action": {
            "type": "string",
            "enum": [
              "invoke",
              "set_value",
              "get_value",
              "get_text",
              "toggle",
              "select",
              "scroll",
              "scroll_into_view",
              "expand",
              "collapse"
            ]
          },
          "value": {
            "type": "string",
            "description": "Required only for set_value."
          },
          "horizontal_amount": {
            "type": "string",
            "enum": [
              "large_decrement",
              "small_decrement",
              "no_amount",
              "large_increment",
              "small_increment"
            ],
            "default": "no_amount"
          },
          "vertical_amount": {
            "type": "string",
            "enum": [
              "large_decrement",
              "small_decrement",
              "no_amount",
              "large_increment",
              "small_increment"
            ],
            "default": "no_amount"
          }
        },
        "required": [
          "element_ref",
          "action"
        ]
      },
      "requires_confirmation": true
    },
    {
      "name": "click_element",
      "description": "Click the center of an indexed UI Automation element after access is granted. If UIA is unavailable, this falls back to the center of a visible-window pseudo-element.",
      "parameters": {
        "type": "object",
        "properties": {
          "element_index": {
            "type": "integer",
            "minimum": 0
          },
          "window": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0
              },
              "app": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "app"
            ],
            "additionalProperties": false,
            "description": "Exact window object returned by list_windows, list_apps, or get_window. Never invent one."
          }
        },
        "required": [
          "element_index"
        ]
      },
      "requires_confirmation": true
    },
    {
      "name": "run_sequence",
      "description": "Run a short batch of stable Computer Use input actions after access is granted, then verify with a later observation tool.",
      "parameters": {
        "type": "object",
        "properties": {
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "enum": [
                    "move_mouse",
                    "left_click",
                    "right_click",
                    "middle_click",
                    "double_click",
                    "scroll",
                    "drag",
                    "key_press",
                    "type_text",
                    "wait"
                  ]
                },
                "coordinate": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "x": {
                  "type": "integer",
                  "minimum": 0
                },
                "y": {
                  "type": "integer",
                  "minimum": 0
                },
                "from_x": {
                  "type": "integer",
                  "minimum": 0
                },
                "from_y": {
                  "type": "integer",
                  "minimum": 0
                },
                "to_x": {
                  "type": "integer",
                  "minimum": 0
                },
                "to_y": {
                  "type": "integer",
                  "minimum": 0
                },
                "scroll_x": {
                  "type": "integer"
                },
                "scroll_y": {
                  "type": "integer"
                },
                "key": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              },
              "required": [
                "tool"
              ]
            }
          }
        },
        "required": [
          "actions"
        ]
      },
      "requires_confirmation": true
    },
    {
      "name": "move_mouse",
      "description": "Move the mouse cursor to a non-negative screen coordinate after access is granted.",
      "parameters": {
        "type": "object",
        "properties": {
          "coordinate": {
            "type": "array",
